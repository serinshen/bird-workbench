{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bird-workbench",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Serves the static site and /api + /media. Do not attach a production custom domain here.
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bird-workbench",
      "database_id": "3cb7a2c6-e07d-4e7c-9fb4-7ed52a57122b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bird-workbench-photos"
    }
  ]
}
